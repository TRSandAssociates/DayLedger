rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateString(s) {
      return s is string && s.size() == 10 && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeOrEmpty(s) {
      return s is string && (s == '' || (s.size() == 5 && s.matches('^[0-2][0-9]:[0-5][0-9]$')));
    }

    function isValidWorkItem(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.category in ['CLASS_BATCH', 'OFFICE_WORK', 'CLIENT_TASK', 'PERSONAL'] &&
             isValidDateString(data.scheduledDate) &&
             isValidTimeOrEmpty(data.startTime) &&
             data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 720 &&
             data.recurrence in ['NONE', 'DAILY', 'WEEKDAYS', 'WEEKLY'] &&
             data.completed is bool &&
             data.batchOrGroup is string && data.batchOrGroup.size() <= 80 &&
             data.clientId is string && data.clientId.size() <= 128 &&
             data.clientName is string && data.clientName.size() <= 80 &&
             data.billable is bool &&
             data.billingAmount is number && data.billingAmount >= 0 && data.billingAmount <= 10000000 &&
             data.reminderMinutesBefore is int && data.reminderMinutesBefore >= -1 && data.reminderMinutesBefore <= 1440 &&
             data.calendarEventId is int && data.calendarEventId >= -1 &&
             data.calendarSynced is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidClient(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.organization is string && data.organization.size() <= 80 &&
             data.email is string && data.email.size() <= 120 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.defaultRate is number && data.defaultRate >= 0 && data.defaultRate <= 10000000 &&
             data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 5 &&
             data.notes is string && data.notes.size() <= 400 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidInvoice(data, userId) {
      return data.userId == userId &&
             data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 32 &&
             data.clientId is string && data.clientId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 80 &&
             data.workTitle is string && data.workTitle.size() >= 1 && data.workTitle.size() <= 120 &&
             data.workItemId is string && data.workItemId.size() <= 128 &&
             data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
             data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= data.amount &&
             data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 5 &&
             data.status in ['UNPAID', 'PARTIAL', 'PAID', 'OVERDUE'] &&
             isValidDateString(data.dueDate) &&
             (data.paidDate == '' || isValidDateString(data.paidDate)) &&
             data.notes is string && data.notes.size() <= 400 &&
             data.reminderEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /workItems/{itemId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(itemId);
        allow create: if isOwner(userId) &&
                         isValidId(itemId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'notes', 'category', 'scheduledDate',
                           'startTime', 'durationMinutes', 'recurrence', 'completed',
                           'batchOrGroup', 'clientId', 'clientName', 'billable',
                           'billingAmount', 'reminderMinutesBefore', 'calendarEventId',
                           'calendarSynced', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'notes', 'category', 'scheduledDate',
                           'startTime', 'durationMinutes', 'recurrence', 'completed',
                           'batchOrGroup', 'clientId', 'clientName', 'billable',
                           'billingAmount', 'reminderMinutesBefore', 'calendarEventId',
                           'calendarSynced', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidWorkItem(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(itemId) &&
                         isValidWorkItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Toggle completion
                           incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
                           // Action: Sync calendar metadata
                           incoming().diff(existing()).affectedKeys().hasOnly(['calendarEventId', 'calendarSynced', 'updatedAt']) ||
                           // Action: Edit full task details
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'title', 'notes', 'category', 'scheduledDate', 'startTime',
                             'durationMinutes', 'recurrence', 'completed', 'batchOrGroup',
                             'clientId', 'clientName', 'billable', 'billingAmount',
                             'reminderMinutesBefore', 'calendarEventId', 'calendarSynced', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      match /clients/{clientId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(clientId);
        allow create: if isOwner(userId) &&
                         isValidId(clientId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'organization', 'email', 'phone',
                           'defaultRate', 'currencySymbol', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'organization', 'email', 'phone',
                           'defaultRate', 'currencySymbol', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidClient(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(clientId) &&
                         isValidClient(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'organization', 'email', 'phone',
                           'defaultRate', 'currencySymbol', 'notes', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(clientId);
      }

      match /invoices/{invoiceId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(invoiceId);
        allow create: if isOwner(userId) &&
                         isValidId(invoiceId) &&
                         incoming().keys().hasAll([
                           'userId', 'invoiceNumber', 'clientId', 'clientName', 'workTitle',
                           'workItemId', 'amount', 'paidAmount', 'currencySymbol', 'status',
                           'dueDate', 'paidDate', 'notes', 'reminderEnabled', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'invoiceNumber', 'clientId', 'clientName', 'workTitle',
                           'workItemId', 'amount', 'paidAmount', 'currencySymbol', 'status',
                           'dueDate', 'paidDate', 'notes', 'reminderEnabled', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidInvoice(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(invoiceId) &&
                         isValidInvoice(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Record payment / update status while not yet settled
                           (existing().status != 'PAID' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'paidAmount', 'status', 'paidDate', 'reminderEnabled', 'updatedAt'
                            ])) ||
                           // Action: Edit invoice details before paid
                           (existing().status != 'PAID' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'invoiceNumber', 'clientId', 'clientName', 'workTitle',
                              'amount', 'paidAmount', 'currencySymbol', 'status',
                              'dueDate', 'paidDate', 'notes', 'reminderEnabled', 'updatedAt'
                            ])) ||
                           // Action: Update notes only on settled invoices
                           (existing().status == 'PAID' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt']))
                         );

        allow delete: if isOwner(userId) && isValidId(invoiceId);
      }
    }
  }
}
